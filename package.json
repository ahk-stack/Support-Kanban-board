{
  "name": "outlook-support-kanban-web",
  "version": "1.0.0",
  "private": true,
  "description": "Secure web app wrapper for Outlook Support Kanban",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup:create": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-create.ps1",
    "backup:list": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-list.ps1",
    "release:snapshot": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-snapshot.ps1",
    "check": "node --check server.js",
    "check:m365": "node scripts/check-m365.js",
    "translate:serve": "docker compose -f docker/libretranslate.compose.yml up -d",
    "translate:stop": "docker compose -f docker/libretranslate.compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prisma": "^7.10.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "^4.12.25"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
